# Copy this file to .env and replace placeholder values with local/deployment credentials.
# Never commit .env.

# Server
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret

# MongoDB (used with MongoDB Compass -> connect using this same URI)
MONGO_URI=mongodb://127.0.0.1:27017/rescueConnectDB

# MySQL (optional companion relational store - used for Fund/Analytics reporting)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_DATABASE=rescue_connect

# Fixed Admin credentials (also seeded into MongoDB users collection)
ADMIN_EMAIL=admin@rescueconnect
ADMIN_PASSWORD=replace-with-admin-password
